<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.freeblock.daemon</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/local/bin/freeblockd</string>
    </array>

    <!-- Start on boot, keep running, restart immediately on exit -->
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>ThrottleInterval</key>
    <integer>0</integer>
</dict>
</plist>
